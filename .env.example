# =============================================================================
# .env.example — copy to .env and fill in for local development
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Supabase (local `supabase start` prints these)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# Column Bank (TrustSync)
COLUMN_BANK_API_KEY=
COLUMN_BANK_API_URL=https://api.column.com/v1

# Streamline PMS (cross-product)
STREAMLINE_API_KEY=
STREAMLINE_API_URL=https://api.streamlinevrs.com

# Sage Intacct (RevPost)
INTACCT_API_USER=
INTACCT_API_PASSWORD=
INTACCT_COMPANY_ID=

# Stripe (Chargeback)
STRIPE_API_KEY=

# Messaging / comms
SLACK_BOT_TOKEN=
GMAIL_REFRESH_TOKEN=

# Safety rails
KILL_SWITCH_GLOBAL=false
MATURITY_DEFAULT=shadow
ORCHESTRATOR_TICK_SECONDS=60

# Dashboard
DASHBOARD_PORT=3100
