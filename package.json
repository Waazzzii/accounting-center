{
  "name": "@acme/accounting-center",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous accounting operating system for ACME House Company — 41 AI agents across 6 products coordinated via event bus + Supabase + Claude Agent SDK.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'config/**/*.yaml'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "agent": "tsx src/cli/run-agent.ts",
    "dashboard:dev": "tsx watch src/dashboard/server.ts",
    "dashboard:build": "tsc -p src/dashboard/tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:types": "supabase gen types typescript --local > src/shared/database.types.ts",
    "events:validate": "tsx scripts/validate-events.ts",
    "kpi:recompute": "tsx scripts/recompute-kpi.ts",
    "audit:verify-chain": "tsx scripts/verify-audit-chain.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.5.0",
    "@anthropic-ai/sdk": "^0.36.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8",
    "yaml": "^2.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "nanoid": "^5.0.8",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "ws": "^8.18.0",
    "handlebars": "^4.7.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "supabase": "^2.84.0"
  },
  "workspaces": [
    "src/agents/phase-*"
  ]
}
